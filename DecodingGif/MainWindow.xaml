<Window x:Class="DecodingGif.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DecodingGif.UI.ViewModels"
        xmlns:conv="clr-namespace:DecodingGif.UI.Converters"
        xmlns:ctrl="clr-namespace:DecodingGif.UI.Controls"
        mc:Ignorable="d"
        Closing="Window_Closing"
        Title="DecodingGif" Height="700" Width="1400">

    <Window.Resources>
        <conv:HexCellBackgroundConverter x:Key="HexCellBackgroundConverter"/>
        <conv:HexCellBorderConverter x:Key="HexCellBorderConverter"/>
        <conv:HexCellTooltipConverter x:Key="HexCellTooltipConverter"/>
        <conv:HexCellIsReadOnlyConverter x:Key="HexCellIsReadOnlyConverter"/>
        <conv:PriorityColorConverter x:Key="PriorityColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="HexCellEditingStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource HexCellIsReadOnlyConverter}">
                        <!-- 0: row offset -->
                        <Binding Path="Offset"/>
                        <!-- 1: column header -->
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="Column.Header"/>
                        <!-- 2: safe mode -->
                        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.IsSafeMode"/>
                        <!-- 3: GCT range -->
                        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.GctRange"/>
                        <!-- 4: allow selected LCT -->
                        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.AllowSelectedLctEdit"/>
                        <!-- 5: selected LCT range -->
                        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.SelectedLctRange"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Open GIF" Command="{Binding OpenFileCommand}" Height="32" Width="120"/>
            <ComboBox ItemsSource="{Binding TutorialScenarios}"
                      SelectedValuePath="Id"
                      DisplayMemberPath="Name"
                      SelectedValue="{Binding SelectedTutorialScenarioId, Mode=TwoWay}"
                      Height="32"
                      Width="210"
                      Margin="8,0,0,0"/>
            <Button Content="Запустить tutorial" Command="{Binding StartTutorialCommand}" Height="32" Width="150" Margin="8,0,0,0"/>
            <Button Content="{Binding UndoDescription}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Height="32" Margin="8,0,0,0" MinWidth="120"/>
            <Button Content="{Binding RedoDescription}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Height="32" Margin="8,0,0,0" MinWidth="120"/>
            <Button Content="Save Changes" Command="{Binding SaveChangesCommand}" IsEnabled="{Binding HasUnsavedChanges}" Height="32" Margin="8,0,0,0" MinWidth="120"/>
            <Button Content="Reset to Original" Command="{Binding ResetChangesCommand}" IsEnabled="{Binding HasUnsavedChanges}" Height="32" Margin="8,0,0,0" MinWidth="140"/>
            <TextBlock Text="Unsaved changes" Foreground="#c2410c" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding LastCommandDescription, StringFormat=Last: {0}}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="2*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ctrl:FileOverviewControl x:Name="FileOverview"
                                          Grid.Column="0"
                                          Margin="0,0,6,0"
                                          Blocks="{Binding Blocks}"
                                          FileLength="{Binding FileLength}"
                                          SelectedOffset="{Binding SelectedByteOffset}"
                                          HoveredOffset="{Binding HoveredByteOffset}"
                                          ToolTip="File overview: click to jump"/>

                <!-- HEX VIEW -->
                <DataGrid x:Name="HexGrid"
                    Grid.Column="1"
                    ItemsSource="{Binding HexRows}"
                    IsReadOnly="False"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    EnableRowVirtualization="True"
                    EnableColumnVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.CacheLength="2"
                    VirtualizingPanel.CacheLengthUnit="Page"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.IsDeferredScrollingEnabled="True"
                    HeadersVisibility="Column"
                    SelectionMode="Single"
                    SelectionUnit="Cell"
                    PreviewMouseRightButtonDown="HexGrid_PreviewMouseRightButtonDown"
                    MouseMove="HexGrid_MouseMove"
                    MouseLeave="HexGrid_MouseLeave"
                    SelectedCellsChanged="HexGrid_SelectedCellsChanged">

                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{Binding DeleteBlockMenuText}"
                                      Command="{Binding DeleteSelectedBlockCommand}"
                                      IsEnabled="{Binding CanDeleteSelectedBlock}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="#334155"/>
                            <Setter Property="Background">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource HexCellBackgroundConverter}">
                                        <!-- 0: row offset -->
                                        <Binding Path="Offset"/>
                                        <!-- 1: column header -->
                                        <Binding RelativeSource="{RelativeSource Self}" Path="Column.Header"/>
                                        <!-- 2: blocks list -->
                                        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.Blocks"/>
                                        <!-- 3: selected byte offset -->
                                        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.SelectedByteOffset"/>
                                        <!-- 4: hovered byte offset -->
                                        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.HoveredByteOffset"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="BorderThickness">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource HexCellBorderConverter}">
                                        <Binding Path="Offset"/>
                                        <Binding RelativeSource="{RelativeSource Self}" Path="Column.Header"/>
                                        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.Blocks"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource HexCellTooltipConverter}">
                                        <Binding Path="Offset"/>
                                        <Binding RelativeSource="{RelativeSource Self}" Path="Column.Header"/>
                                        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.Blocks"/>
                                        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.CreatorAnalysis"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Offset" Binding="{Binding OffsetHex}" Width="80" IsReadOnly="True"/>

                    <DataGridTextColumn Header="00" Binding="{Binding B00}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>
                    <DataGridTextColumn Header="01" Binding="{Binding B01}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>
                    <DataGridTextColumn Header="02" Binding="{Binding B02}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>
                    <DataGridTextColumn Header="03" Binding="{Binding B03}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>
                    <DataGridTextColumn Header="04" Binding="{Binding B04}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>
                    <DataGridTextColumn Header="05" Binding="{Binding B05}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>
                    <DataGridTextColumn Header="06" Binding="{Binding B06}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>
                    <DataGridTextColumn Header="07" Binding="{Binding B07}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>
                    <DataGridTextColumn Header="08" Binding="{Binding B08}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>
                    <DataGridTextColumn Header="09" Binding="{Binding B09}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>
                    <DataGridTextColumn Header="0A" Binding="{Binding B10}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>
                    <DataGridTextColumn Header="0B" Binding="{Binding B11}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>
                    <DataGridTextColumn Header="0C" Binding="{Binding B12}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>
                    <DataGridTextColumn Header="0D" Binding="{Binding B13}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>
                    <DataGridTextColumn Header="0E" Binding="{Binding B14}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>
                    <DataGridTextColumn Header="0F" Binding="{Binding B15}" Width="40" EditingElementStyle="{StaticResource HexCellEditingStyle}"/>

                        <DataGridTextColumn Header="ASCII" Binding="{Binding Ascii}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Background="#CBD5E1"
                          ShowsPreview="True"/>

            <!-- RIGHT PANEL --> 
            <ScrollViewer Grid.Column="2" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <TextBlock Text="Preview" FontWeight="Bold" Margin="0,0,0,6"/>
                <Border BorderBrush="LightGray" BorderThickness="1" Padding="4" Margin="0,0,0,12">
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" Height="220"/>
                </Border>
                <TextBlock Text="{Binding FrameLabel}" Margin="0,0,0,8" FontWeight="SemiBold"/>

                <GroupBox Header="Animation Playback" Margin="0,0,0,12">
                    <StackPanel Orientation="Vertical" Margin="5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                            <Button Command="{Binding RestartCommand}" Content="&#x23EE;" Width="30" Height="30" ToolTip="Restart Animation"/>
                            <Button Command="{Binding StepBackwardCommand}" Content="&#x23EA;" Width="30" Height="30" Margin="4,0,0,0" ToolTip="Step Backward"/>
                            <Button Command="{Binding PlayCommand}" Content="&#x25B6;" Width="35" Height="30" Margin="4,0,0,0" ToolTip="Play Animation"/>
                            <Button Command="{Binding PauseCommand}" Content="&#x23F8;" Width="30" Height="30" Margin="4,0,0,0" ToolTip="Pause Animation"/>
                            <Button Command="{Binding StopCommand}" Content="&#x23F9;" Width="30" Height="30" Margin="4,0,0,0" ToolTip="Stop Animation"/>
                            <Button Command="{Binding StepForwardCommand}" Content="&#x23E9;" Width="30" Height="30" Margin="4,0,0,0" ToolTip="Step Forward"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                            <TextBlock Text="Speed:" VerticalAlignment="Center"/>
                            <Slider Value="{Binding PlaybackSpeed}" Minimum="0.1" Maximum="5.0" Width="100" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding PlaybackSpeedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding IsLooping}" Content="Loop Animation" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding TotalAnimationText}" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Animation Timeline" Margin="0,0,0,12">
                    <DataGrid ItemsSource="{Binding FrameTimeline}" AutoGenerateColumns="False" SelectedIndex="{Binding SelectedFrameIndex}" IsReadOnly="True" CanUserAddRows="False" Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="35"/>
                            <DataGridTextColumn Header="Delay" Binding="{Binding DelayText}" Width="65"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding CumulativeTimeMs, StringFormat={}{0}ms}" Width="70"/>
                            <DataGridTextColumn Header="Frame" Binding="{Binding FrameDetails}" Width="170"/>
                            <DataGridTextColumn Header="Disposal" Binding="{Binding DisposalText}" Width="70"/>
                            <DataGridTextColumn Header="Alpha" Binding="{Binding HasTransparency}" Width="60"/>
                            <DataGridTextColumn Header="TrIdx" Binding="{Binding TransparentIndex}" Width="55"/>
                            <DataGridTextColumn Header="LCT" Binding="{Binding HasLocalColorTable}" Width="50"/>
                            <DataGridTextColumn Header="LCT Size" Binding="{Binding LocalColorTableSize}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Prev" Command="{Binding PrevFrameCommand}" Width="60"/>
                    <Button Content="Next" Command="{Binding NextFrameCommand}" Width="60" Margin="8,0,0,0"/>
                    <Button Content="Insert" Command="{Binding InsertFrameCommand}" Width="70" Margin="8,0,0,0"/>
                    <Button Content="Duplicate" Command="{Binding DuplicateFrameCommand}" Width="80" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock Text="Info" FontWeight="Bold" Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <TextBlock Text="Selected byte:" FontWeight="Bold" Margin="0,0,0,6"/>

                <StackPanel DataContext="{Binding SelectedByte}">
                    <TextBlock Text="{Binding OffsetHex, StringFormat=Offset (hex): {0}}" />
                    <TextBlock Text="{Binding Offset, StringFormat=Offset (dec): {0}}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding ValueHex, StringFormat=Value (hex): {0}}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding ValueDec, StringFormat=Value (dec): {0}}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Ascii, StringFormat=ASCII: {0}}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Visibility="{Binding HasSelectedColorInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Color:" FontWeight="Bold" Margin="0,14,0,6"/>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedColorTableLabel}" />
                        <TextBlock Text="{Binding SelectedColorIndex, StringFormat=Color index: {0}}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding SelectedColorChannel}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding SelectedColorRgbText}" Margin="0,2,0,0"/>
                        <Border Width="48" Height="20" BorderBrush="Gray" BorderThickness="1" Background="{Binding SelectedColorBrush}" Margin="0,6,0,0"/>
                        <Button Content="Pick color" Command="{Binding PickColorCommand}" IsEnabled="{Binding SelectedColorCanEdit}" Width="100" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding HasSelectedByteMeaning, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Meaning:" FontWeight="Bold" Margin="0,14,0,6"/>
                    <TextBlock Text="{Binding SelectedByteMeaning}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Visibility="{Binding HasSelectedGceInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="GCE:" FontWeight="Bold" Margin="0,14,0,6"/>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedGceLabel}" />
                        <TextBlock Text="{Binding SelectedGceDelayText}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding SelectedGceDisposalText}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding SelectedGceTransparencyText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding HasSelectedLsdInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="LSD:" FontWeight="Bold" Margin="0,14,0,6"/>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedLsdLabel}" />
                        <TextBlock Text="{Binding SelectedLsdDimensions}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding SelectedLsdGctPresent}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding SelectedLsdGctSize}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding SelectedLsdColorResolution}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding SelectedLsdSortFlag}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding SelectedLsdBackgroundIndex}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding SelectedLsdPixelAspect}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding SelectedLsdBackgroundRgb}" Margin="0,2,0,0"/>
                        <Border Width="48" Height="20" BorderBrush="Gray" BorderThickness="1" Background="{Binding SelectedLsdBackgroundBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Structure:" FontWeight="Bold" Margin="0,14,0,6"/>

                <TabControl Height="380" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                    <TabItem Header="Tree View">
                        <TreeView x:Name="StructureTree"
                                  ItemsSource="{Binding StructureRoots}"
                                  SelectedItemChanged="StructureTree_SelectedItemChanged">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Title}" />
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </TabItem>

                    <TabItem x:Name="GraphTab" Header="Graph View" MouseDoubleClick="GraphTab_MouseDoubleClick">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="4">
                                <WrapPanel>
                                    <Button Content="Reset Layout" Command="{Binding ResetGraphLayoutCommand}" Margin="0,0,8,4"/>
                                    <ComboBox Width="130" Margin="0,0,8,4" SelectedItem="{Binding GraphLayoutMode}" ItemsSource="{Binding GraphLayoutModes}"/>
                                    <CheckBox Content="Show Edge Labels" IsChecked="{Binding ShowEdgeLabels}" Margin="0,0,8,4"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <CheckBox Content="Sequential" IsChecked="{Binding ShowSequentialEdges}" Margin="0,0,8,4"/>
                                    <CheckBox Content="Dependencies" IsChecked="{Binding ShowDependencyEdges}" Margin="0,0,8,4"/>
                                    <CheckBox Content="Shared" IsChecked="{Binding ShowSharedResourceEdges}" Margin="0,0,8,4"/>
                                    <CheckBox Content="Temporal" IsChecked="{Binding ShowTemporalEdges}" Margin="0,0,8,4"/>
                                    <CheckBox Content="DataFlow" IsChecked="{Binding ShowDataFlowEdges}" Margin="0,0,8,4"/>
                                </WrapPanel>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ctrl:StructureGraphControl x:Name="StructureGraphControl"
                                                            Graph="{Binding StructureGraph}"
                                                            ShowEdgeLabels="{Binding ShowEdgeLabels}"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="MemoryLayoutTab" Header="Memory Layout" MouseDoubleClick="MemoryLayoutTab_MouseDoubleClick">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="4">
                                <WrapPanel>
                                    <TextBlock Text="Bytes per row:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox Width="85"
                                              ItemsSource="{Binding BytesPerRowOptions}"
                                              SelectedItem="{Binding BytesPerRow}"/>
                                    <CheckBox Content="Show alignment grid" IsChecked="{Binding ShowAlignmentGrid}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <CheckBox Content="Show empty space" IsChecked="{Binding ShowEmptySpace}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <CheckBox Content="Compress large blocks" IsChecked="{Binding CompressLargeBlocks}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </WrapPanel>

                                <WrapPanel Margin="0,6,0,0">
                                    <TextBlock Text="Legend:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <Border Width="14" Height="14" Background="#1e40af" BorderBrush="Gray" BorderThickness="0.5" Margin="0,0,4,0"/>
                                    <TextBlock Text="Header/LSD" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <Border Width="14" Height="14" Background="#16a34a" BorderBrush="Gray" BorderThickness="0.5" Margin="0,0,4,0"/>
                                    <TextBlock Text="GCT" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <Border Width="14" Height="14" Background="#22c55e" BorderBrush="Gray" BorderThickness="0.5" Margin="0,0,4,0"/>
                                    <TextBlock Text="LCT" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <Border Width="14" Height="14" Background="#9333ea" BorderBrush="Gray" BorderThickness="0.5" Margin="0,0,4,0"/>
                                    <TextBlock Text="GCE" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <Border Width="14" Height="14" Background="#ea580c" BorderBrush="Gray" BorderThickness="0.5" Margin="0,0,4,0"/>
                                    <TextBlock Text="Image Descriptor" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <Border Width="14" Height="14" Background="#fb923c" BorderBrush="Gray" BorderThickness="0.5" Margin="0,0,4,0"/>
                                    <TextBlock Text="Image Data" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <Border Width="14" Height="14" Background="#a855f7" BorderBrush="Gray" BorderThickness="0.5" Margin="0,0,4,0"/>
                                    <TextBlock Text="Extensions" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <Border Width="14" Height="14" Background="#f3f4f6" BorderBrush="Gray" BorderThickness="0.5" Margin="0,0,4,0"/>
                                    <TextBlock Text="Empty" VerticalAlignment="Center"/>
                                </WrapPanel>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ctrl:MemoryLayoutControl x:Name="MemoryLayoutControl"
                                                          Layout="{Binding MemoryLayout}"
                                                          ShowAlignmentGrid="{Binding ShowAlignmentGrid}"
                                                          ShowEmptySpace="{Binding ShowEmptySpace}"/>
                            </ScrollViewer>

                            <GroupBox Grid.Row="2" Header="Статистика memory layout" Margin="4">
                                <StackPanel Margin="6,2">
                                    <TextBlock Text="{Binding MemoryLayoutBuildStatusText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <WrapPanel>
                                        <TextBlock Text="{Binding MemoryFileSizeText}" Margin="8,0"/>
                                        <TextBlock Text="{Binding DataUtilizationText}" Margin="8,0"/>
                                        <TextBlock Text="{Binding LargestBlockText}" Margin="8,0"/>
                                        <TextBlock Text="{Binding FragmentationText}" Margin="8,0"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,2,0,0">
                                        <TextBlock Text="{Binding FileSizeHeadersText}" Margin="8,0"/>
                                        <TextBlock Text="{Binding FileSizePalettesText}" Margin="8,0"/>
                                        <TextBlock Text="{Binding FileSizeImageDataText}" Margin="8,0"/>
                                        <TextBlock Text="{Binding FileSizeExtensionsText}" Margin="8,0"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,2,0,0">
                                        <TextBlock Text="{Binding MemoryDecompressedText}" Margin="8,0"/>
                                        <TextBlock Text="{Binding MemoryLzwDictionaryText}" Margin="8,0"/>
                                        <TextBlock Text="{Binding MemoryAnimationBufferText}" Margin="8,0"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,2,0,0">
                                        <TextBlock Text="{Binding PerformanceParseComplexityText}" Margin="8,0"/>
                                        <TextBlock Text="{Binding PerformanceFrameRateText}" Margin="8,0"/>
                                        <TextBlock Text="{Binding PerformanceDisposalComplexityText}" Margin="8,0"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,2,0,0">
                                        <TextBlock Text="{Binding CreatorSoftwareText}" Margin="8,0"/>
                                        <TextBlock Text="{Binding CreatorEraText}" Margin="8,0"/>
                                        <TextBlock Text="{Binding CreatorConfidenceText}" Margin="8,0"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding CreatorEvidenceText}" Margin="8,2,8,0" TextWrapping="Wrap"/>

                                    <GroupBox Header="Цифровая форензика" Margin="0,8,0,0">
                                        <StackPanel Margin="6,4">
                                            <TextBlock Text="{Binding CreatorAnalysis.PrimaryCreator.SoftwareName}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding CreatorAnalysis.ConfidenceText}" Foreground="DarkBlue"/>
                                            <TextBlock Text="{Binding CreatorAnalysis.EstimatedEra}" FontSize="11"/>
                                            <TextBlock Text="{Binding CreatorAnalysis.ClassificationText}" FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding ForensicQuickSummaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                            <ItemsControl ItemsSource="{Binding CreatorAnalysis.KeyEvidence}" Margin="0,5,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="10" Foreground="Gray" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding CreatorAnalysis.AlternativeCandidatesText}"
                                                       Visibility="{Binding ForensicAlternativesVisibility}"
                                                       FontSize="10"
                                                       Foreground="DarkGray"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </GroupBox>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="LzwTab" Header="LZW Decompression" MouseDoubleClick="LzwTab_MouseDoubleClick">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <GroupBox Grid.Row="0" Header="Controls" Margin="0,0,0,6">
                                <StackPanel Margin="6">
                                    <WrapPanel>
                                        <Button Content="Start"
                                                Command="{Binding StartLZWVisualizationCommand}"
                                                Width="72"
                                                Margin="0,0,6,0"/>
                                        <Button Content="Reset"
                                                Command="{Binding LZWResetCommand}"
                                                Width="72"
                                                Margin="0,0,6,0"/>
                                        <Button Content="Step Back"
                                                Command="{Binding LZWStepBackwardCommand}"
                                                Width="82"
                                                Margin="0,0,6,0"/>
                                        <Button Content="Play"
                                                Command="{Binding LZWPlayCommand}"
                                                Width="68"
                                                Margin="0,0,6,0"/>
                                        <Button Content="Pause"
                                                Command="{Binding LZWPauseCommand}"
                                                Width="68"
                                                Margin="0,0,6,0"/>
                                        <Button Content="Step Forward"
                                                Command="{Binding LZWStepForwardCommand}"
                                                Width="95"/>
                                    </WrapPanel>

                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock Text="Speed (ms):" VerticalAlignment="Center"/>
                                        <Slider Minimum="100"
                                                Maximum="2000"
                                                TickFrequency="100"
                                                IsSnapToTickEnabled="True"
                                                Width="180"
                                                Margin="8,0,0,0"
                                                Value="{Binding LZWAnimationSpeed}"/>
                                        <TextBlock Text="{Binding LZWAnimationSpeed, StringFormat={}{0} ms}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                        <CheckBox Content="?????????? ?????? ????? ????"
                                                  IsChecked="{Binding ShowOnlyNewLzwCodes}"
                                                  Margin="14,0,0,0"
                                                  VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                                <ctrl:LZWVisualizationControl DecompressionState="{Binding LZWState}"
                                                              CompressedData="{Binding LZWCompressedData}"
                                                              IsVisualizationActive="{Binding IsLZWVisualizationActive}"
                                                              ShowOnlyDynamicCodes="{Binding ShowOnlyNewLzwCodes}"
                                                              ErrorMessage="{Binding ErrorText}"/>
                            </Border>

                            <GroupBox Grid.Row="2" Header="Status" Margin="0,6,0,0">
                                <StackPanel Margin="6">
                                    <TextBlock Text="{Binding LzwProgressText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding LZWStatisticsText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding LZWWarningText}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#B45309"/>
                                    <TextBlock Text="{Binding IsLZWVisualizationActive, StringFormat=LZW Active: {0}}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </GroupBox>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="AnimationPropertiesTab" Header="Animation Properties" MouseDoubleClick="AnimationPropertiesTab_MouseDoubleClick">
                        <ctrl:AnimationPropertiesEditorControl DataContext="{Binding AnimationPropertiesEditor}"
                                                               Editor="{Binding}"/>
                    </TabItem>

                    <TabItem x:Name="PaletteTab" Header="Palette Editor" MouseDoubleClick="PaletteTab_MouseDoubleClick">
                        <ctrl:ColorPaletteEditorControl DataContext="{Binding PaletteEditor.ColorEditor}"
                                                        Palette="{Binding}"
                                                        EditMode="{Binding CurrentMode, Mode=TwoWay}"/>
                    </TabItem>
                </TabControl>

                <GroupBox Header="Optimization Suggestions" Margin="0,12,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding OptimizationSummary}" Margin="4,2,4,6" FontStyle="Italic"/>
                        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OptimizationSuggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#CBD5E1" BorderThickness="1" Margin="2" Padding="6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Priority}" FontWeight="Bold" Foreground="{Binding Priority, Converter={StaticResource PriorityColorConverter}}"/>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="10,0,0,0"/>
                                                    <TextBlock Text="{Binding Impact}" Margin="10,0,0,0" FontStyle="Italic"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <ctrl:TutorialOverlayControl Grid.ColumnSpan="2"
                                         Panel.ZIndex="1000"
                                         Visibility="{Binding IsTutorialActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </DockPanel>
</Window>
